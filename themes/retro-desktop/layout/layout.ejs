<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <%
    var pageTitle = page.title ? page.title + ' · ' + config.title : '❤ ' + config.title + ' ❤';
  %>
  <title><%= pageTitle %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= config.description %>">
  <meta name="author" content="<%= config.author %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:description" content="<%= config.description %>">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <% if (config.feed && config.feed.path) { %>
  <link rel="alternate" href="/<%= config.feed.path %>" type="application/atom+xml" title="<%= config.title %>">
  <% } %>
  <%- css('css/desktop.css') %>
  <% if (page.layout === 'admin') { %><%- css('css/admin-editor.css') %><% } %>
  <script>
    document.documentElement.dataset.motion =
      matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduce' : 'full';
  </script>
</head>
<body>
  <a class="skip-link" href="#main">跳到正文</a>

  <!-- 梦幻背景层：流体渐变 + 网格 + 漂浮像素物件 -->
  <div id="outer-bg" aria-hidden="true">
    <canvas id="fluid-canvas"></canvas>
    <div class="bg-grid"></div>
    <div class="drift-layer">
      <span class="pixel-object" style="left:6%;top:14%;--d:26s;--delay:0s;--s:1">
        <svg viewBox="0 0 16 16" class="px"><path fill="#ff9dc6" d="M2 3h4v2h4V3h4v4h-2v2h-2v2h-2v2H8v-2H6v-2H4V9H2V7H2V3z"/><path fill="#ffd0e6" d="M4 4h2v2H4z"/></svg>
      </span>
      <span class="pixel-object" style="left:88%;top:8%;--d:32s;--delay:-8s;--s:1.4">
        <svg viewBox="0 0 16 16" class="px"><path fill="#fff6c9" d="M7 0h2v6h6v2H9v6H7V8H1V6h6V0z"/></svg>
      </span>
      <span class="pixel-object" style="left:14%;top:62%;--d:38s;--delay:-15s;--s:1.6">
        <svg viewBox="0 0 16 16" class="px"><rect x="1" y="1" width="14" height="14" fill="#8f6fc0"/><rect x="3" y="3" width="10" height="6" fill="#d9c6f2"/><rect x="10" y="11" width="3" height="3" fill="#f2e6ff"/><rect x="4" y="11" width="4" height="2" fill="#6b4d99"/></svg>
      </span>
      <span class="pixel-object" style="left:70%;top:48%;--d:30s;--delay:-4s;--s:1.2">
        <svg viewBox="0 0 16 16" class="px"><circle cx="8" cy="8" r="7" fill="#e6d4f5"/><circle cx="8" cy="8" r="2.5" fill="#b18bc7"/><circle cx="8" cy="8" r="1" fill="#fff"/><path d="M8 1v3M8 12v3M1 8h3M12 8h3" stroke="#c9aee0" stroke-width="1"/></svg>
      </span>
      <span class="pixel-object" style="left:30%;top:34%;--d:44s;--delay:-22s;--s:1.3">
        <svg viewBox="0 0 16 16" class="px"><rect x="2" y="3" width="12" height="9" fill="#c9aee0"/><rect x="4" y="5" width="8" height="5" fill="#f5e9ff"/><rect x="6" y="12" width="4" height="2" fill="#8f6fc0"/><rect x="4" y="14" width="8" height="1" fill="#8f6fc0"/></svg>
      </span>
      <span class="pixel-object" style="left:52%;top:74%;--d:36s;--delay:-11s;--s:0.9">
        <svg viewBox="0 0 16 16" class="px"><path fill="#ffb3d9" d="M2 3h4v2h4V3h4v4h-2v2h-2v2h-2v2H8v-2H6v-2H4V9H2V7H2V3z"/></svg>
      </span>
      <span class="pixel-object" style="left:94%;top:70%;--d:28s;--delay:-17s;--s:1.1">
        <svg viewBox="0 0 16 16" class="px"><path fill="#ffffff" d="M7 0h2v6h6v2H9v6H7V8H1V6h6V0z"/></svg>
      </span>
      <span class="pixel-object" style="left:40%;top:88%;--d:34s;--delay:-6s;--s:1">
        <svg viewBox="0 0 16 16" class="px"><rect x="1" y="3" width="14" height="10" fill="#e6c9ef"/><rect x="2" y="4" width="12" height="8" fill="#fff9fd"/><path d="M2 4l6 5 6-5" stroke="#c9aee0" stroke-width="1" fill="none"/></svg>
      </span>
      <!-- 漂浮的迷你窗口 -->
      <span class="window-object retro-mini" style="left:80%;top:30%;--d:48s;--delay:-20s;width:120px">
        <i class="mini-title"></i><i class="mini-screen"></i>
      </span>
      <span class="window-object retro-mini" style="left:4%;top:44%;--d:56s;--delay:-33s;width:96px">
        <i class="mini-title"></i><i class="mini-screen"></i>
      </span>
    </div>
  </div>

  <div class="desktop" id="desktop">

    <!-- 浏览器窗口（全站外壳） -->
    <header class="window browser-window">
      <div class="window-title">
        <a href="/">✿ <%= config.title %></a>
        <span class="window-controls" aria-hidden="true"><i>_</i><i>□</i><i>×</i></span>
      </div>
      <div class="browser-toolbar">
        <nav aria-label="主导航">
          <a class="bevel-button<%= is_home() ? ' is-active' : '' %>" href="/" <%= is_home() ? 'aria-current="page"' : '' %>>主页</a>
          <% (theme.nav || []).forEach(function(item){ %>
          <a class="bevel-button" href="<%- item.url %>"><%= item.name %></a>
          <% }) %>
          <button class="bevel-button lucky" id="lucky-btn" type="button" title="随机跳转到一篇文章">手气不错</button>
        </nav>
        <div class="toolbar-right">
          <div class="theme-switcher" role="group" aria-label="切换配色主题">
            <span class="swatch-label">配色</span>
            <button class="swatch" data-theme="dream" type="button" title="梦幻粉紫" aria-label="梦幻粉紫"></button>
            <button class="swatch" data-theme="classic" type="button" title="经典桌面" aria-label="经典桌面"></button>
            <button class="swatch" data-theme="crt" type="button" title="暗夜终端" aria-label="暗夜终端"></button>
            <button class="swatch" data-theme="ocean" type="button" title="海盐蓝" aria-label="海盐蓝"></button>
          </div>
          <button id="search-toggle" class="bevel-button search-btn" type="button" aria-label="站内搜索" aria-haspopup="dialog" aria-controls="search-modal" aria-expanded="false">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M11 11l4 4" stroke="currentColor" stroke-width="2"/></svg>
          </button>
        </div>
      </div>
      <div class="address-row">
        <span>地址</span>
        <a href="<%= config.url %>/" class="inset-field"><span aria-hidden="true">✧</span> <%= config.url.replace(/^https?:\/\//, '') %>/</a>
        <a href="/rss/" class="bevel-button rss-button" aria-label="订阅 RSS">RSS ↗</a>
      </div>
    </header>

    <%- body %>

    <!-- 页脚窗 -->
    <footer class="window footer-window" aria-label="页脚">
      <div class="window-title"><span>♡</span><span class="window-controls" aria-hidden="true"><i>_</i><i>□</i><i>×</i></span></div>
      <div class="footer-body">
        <p class="footer-motto"><%= theme.motto %></p>
        <p class="footer-copy">© <%= date(Date.now(), 'YYYY') %> <%= config.author %></p>
        <p class="footer-links">
          Powered by Hexo · Theme「retro-desktop」 · <a href="/rss/">RSS</a> · <a href="/admin/">⚿ 管理</a> · <button class="sfx-toggle" id="sfx-toggle" type="button">♪ 音效：关</button>
          <br>
          总访问 <b id="site-views">…</b> 次 · 本站已折腾 <b id="site-days">…</b> 天 · <span class="taskbar-clock" id="taskbar-clock">--:--:--</span>
          <br>
          <span class="live-foot" id="live-foot" hidden>
            <span class="online-dot" aria-hidden="true"></span>现在 <b class="lv-online">–</b> 人在线
            <span class="lv-sep">·</span>累计 <b class="lv-uv">–</b> 位访客
            <span class="lv-sep">·</span>今天 <b class="lv-today">–</b> 人来过
          </span>
        </p>
      </div>
    </footer>
  </div>

  <!-- 搜索弹窗 -->
  <div class="modal-mask" id="search-modal" role="dialog" aria-modal="true" aria-label="站内搜索" hidden>
    <div class="window search-window">
      <div class="window-title">
        <span>▤ 站内搜索</span>
        <span class="window-controls"><i id="search-close" role="button" aria-label="关闭">×</i></span>
      </div>
      <div class="search-body">
        <input type="search" id="search-input" class="inset-input" placeholder="输入关键词开始搜索（Ctrl/⌘ + K）" autocomplete="off">
        <div class="search-results inset-panel" id="search-results"><p class="search-tip">输入关键词开始搜索</p></div>
      </div>
    </div>
  </div>

  <canvas id="fx-canvas" aria-hidden="true"></canvas>
  <div id="restore-dock" aria-live="polite"></div>

  <!-- 开机画面 -->
  <div id="boot-screen" role="button" aria-label="跳过开机画面" hidden>
    <div class="boot-logo">CHENQIYUE OS</div>
    <div class="boot-bar"><div class="boot-fill" id="boot-fill"></div></div>
    <div class="boot-tip">正在启动…（点击跳过）</div>
  </div>

  <script>
    window.BLOG_CONFIG = { searchPath: '/search.json' };
    <% if (theme.comments && theme.comments.enable) { %>
    window.COMMENTS_CONFIG = window.COMMENTS_CONFIG || { api: '<%= api_base() %>' };
    // 本地开发（localhost / 127.0.0.1）自动连本机后端，免得把评论发到线上站去
    if (window.COMMENTS_CONFIG && /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)) {
      window.COMMENTS_CONFIG.api = 'http://127.0.0.1:8765';
    }
    <% } %>
  </script>
  <%- js('js/main.js') %>
  <%- js('js/enhance.js') %>
  <%- js('js/visitors.js') %>
  <script src="/js/article-enhance.js?v=3"></script>
  <%- js('js/sfx.js') %>
</body>
</html>
